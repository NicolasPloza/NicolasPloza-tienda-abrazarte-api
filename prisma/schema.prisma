datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Agregamos un modelo inicial para que Prisma pueda generar sus tipos y clases
model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(50)
  descripcion String?    @db.VarChar(255)
  productos   Producto[]
}

model Producto {
  id                     Int            @id @default(autoincrement())
  nombre                 String         @db.VarChar(100)
  descripcion            String?        @db.Text
  precio                 Decimal        @db.Decimal(10, 2)
  stock                  Int            @default(0)
  permitePersonalizacion Boolean        @default(false)
  categoriaId            Int
  categoria              Categoria      @relation(fields: [categoriaId], references: [id])
  fotos                  FotoProducto[]
  itemsCarrito           ItemCarrito[]
  itemsOrden             ItemOrden[] 
  createdAt              DateTime       @default(now())
}

model FotoProducto {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(500)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  orden      Int      @default(0)
  esPrincipal Boolean @default(false)
  createdAt  DateTime @default(now())
}

enum RolUsuario {
  CLIENTE
  ADMINISTRADOR
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  nombre    String   @db.VarChar(100)
  rol       RolUsuario @default(CLIENTE)
  ordenes   Orden[]
  carritos  Carrito[]
  createdAt DateTime @default(now())
}

enum EstadoOrden {
  PENDIENTE_PAGO
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

model Orden {
  id            Int         @id @default(autoincrement())
  nombreCliente String      @db.VarChar(100)
  emailCliente  String      @db.VarChar(150)
  telefono      String      @db.VarChar(50)
  direccion     String      @db.Text
  total         Decimal     @db.Decimal(10, 2)
  estado        EstadoOrden @default(PENDIENTE_PAGO)
  usuarioId     Int?
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  items         ItemOrden[]
  createdAt     DateTime    @default(now())
}

model ItemOrden {
  id             Int      @id @default(autoincrement())
  ordenId        Int
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
}

model Carrito {
  id        Int           @id @default(autoincrement())
  sessionId String?        @unique @db.VarChar(100) // Identificador de sesión temporal
  usuarioId Int?          @unique                  // Opcional si es usuario registrado
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items     ItemCarrito[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ItemCarrito {
  id         Int      @id @default(autoincrement())
  carritoId  Int
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int      @default(1)
}